SJ0821 9940-CHECK-HC-COST-OVERRIDE.
           MOVE OMGPR-D-PRICING        TO WS-TEMP-SCREEN-DATE.
           MOVE WS-TEMP-SCR-DT-CCYY    TO WS-TEMP-DT-CCYY.
           MOVE WS-TEMP-SCR-DT-MM      TO WS-TEMP-DT-MM.
           MOVE WS-TEMP-SCR-DT-DD      TO WS-TEMP-DT-DD.
           MOVE WS-TEMP-DATE-TIMESTAMP TO WS-TEMP-D-PRICING.
           MOVE SPACES                 TO WS-F-HC-COST-REC-FND-SW
                                          WS-F-COST-OVERRIDEN-SW.
           PERFORM 9945-CHECK-HC-COST-ACCOUNT THRU 9945-EXIT. 
           IF WS-F-HC-COST-REC-FND 
              CONTINUE 
           ELSE 
              PERFORM 9950-CHECK-HC-COST-CID THRU 9950-EXIT
           END-IF. 

SJ0821 9940-EXIT.
           EXIT. 

SJ0821 9945-CHECK-HC-COST-ACCOUNT.

           EXEC SQL
              SELECT
                 A.HC_GROUP_ID,
                 A.HC_START_DATE,   
                 A.HC_EXPIRE_DATE,
                 B.HC_GROUP_OVRD_START_DATE,
                 B.HC_GROUP_OVRD_EXPIRE_DATE,
                 B.HC_GROUP_OVRD_FLAG,
                 C.HC_PROD_CST_START_DATE,
                 C.HC_PROD_CST_EXPIRE_DATE,
                 C.HC_PROD_OVRD_FLAG
              INTO
                 :HC-ACT-GROUP-ID,
                 :HC-ACT-START-DATE,
                 :HC-ACT-EXPIRE-DATE
                 :HC-ACT-EXP-DATE-NI,
                 :HC-GROUP-OVRD-START-DATE,
                 :HC-GROUP-OVRD-EXPIRE-DATE
                 :HC-GROUP-OVRD-EXP-DATE-NI,
                 :HC-GROUP-OVRD-FLAG,
                 :HC-PROD-CST-START-DATE,
                 :HC-PROD-CST-EXPIRE-DATE
                 :HC-PROD-CST-EXP-DATE-NI,
                 :HC-PROD-OVRD-FLAG
              FROM
SJ0224           HC_OVRD_GROUP_HEADER H,
                 HC_OVRD_GROUP_ACCOUNT A,
                 HC_OVRD_GROUP_DETAIL B,
                 HC_OVRD_PRODUCT C
              WHERE
SJ0224           H.HC_GROUP_HDR_START_DATE <= :WS-TEMP-D-PRICING AND 
SJ0224           (H.HC_GROUP_HDR_EXPIRE_DATE IS NULL OR
SJ0224            (H.HC_GROUP_HDR_EXPIRE_DATE IS NOT NULL AND 
SJ0224             H.HC_GROUP_HDR_EXPIRE_DATE >= :WS-TEMP-D-PRICING)
SJ0224           ) AND
SJ0224           H.HC_GROUP_ID = A.HC_GROUP_ID AND
                 A.HC_DIVISION = :OMGPR-I-DIVISION AND
                 A.HC_ACCOUNT = :OMGPR-S-ACCOUNT AND 
                 A.HC_START_DATE <= :WS-TEMP-D-PRICING AND 
                 (A.HC_EXPIRE_DATE IS NULL OR 
                  (A.HC_EXPIRE_DATE IS NOT NULL AND 
                   A.HC_EXPIRE_DATE >= :WS-TEMP-D-PRICING)) AND
                 A.HC_GROUP_ID = B.HC_GROUP_ID AND
                 B.HC_GROUP_OVRD_START_DATE <= :WS-TEMP-D-PRICING AND
                 (B.HC_GROUP_OVRD_EXPIRE_DATE IS NULL OR
                  (B.HC_GROUP_OVRD_EXPIRE_DATE IS NOT NULL AND
                   B.HC_GROUP_OVRD_EXPIRE_DATE >= :WS-TEMP-D-PRICING)
                 ) AND
                 A.HC_GROUP_ID = C.HC_GROUP_ID AND
                 C.HC_VEND_NBR = :OMGPR-I-VENDOR AND
                 C.HC_PROD_NBR = :OMGPR-I-VND-PRODUCT AND
                 C.HC_PROD_CST_START_DATE <= :WS-TEMP-D-PRICING AND
                 (C.HC_PROD_CST_EXPIRE_DATE IS NULL OR
                  (C.HC_PROD_CST_EXPIRE_DATE IS NOT NULL AND
                   C.HC_PROD_CST_EXPIRE_DATE >= :WS-TEMP-D-PRICING))
                      
           END-EXEC.

           EVALUATE SQLCODE
              WHEN +0
                 MOVE 'Y'              TO WS-F-HC-COST-REC-FND-SW
                 MOVE HC-ACT-GROUP-ID  TO OMGPR-HC-GROUP-ID
                 IF HC-PROD-OVRD-FLAG = 'Y' OR 'N'
                    MOVE HC-PROD-OVRD-FLAG
                                       TO WS-F-COST-OVERRIDEN-SW 
                 ELSE 
                    MOVE HC-GROUP-OVRD-FLAG  
                                       TO WS-F-COST-OVERRIDEN-SW
                 END-IF 
                 IF HC-PROD-CST-EXP-DATE-NI < 0
                    MOVE WS-HIGH-DATE  TO HC-PROD-CST-EXPIRE-DATE
                 END-IF 

              WHEN +100
                 MOVE SPACES           TO WS-F-HC-COST-REC-FND-SW 
              WHEN OTHER
                 MOVE 'SELECT'         TO WS-DB-OPERATION
                 MOVE 'HC_OVRD_GROUP_ACCOUNT'
                                       TO WS-DB-NAME
                 MOVE SQLCODE          TO WS-DB-RETURN-CODE
