           EXEC SQL
             DECLARE A6Z01_C_CUG07 CURSOR FOR
               SELECT
                 CUG07.I_BUY_GROUP,
                 CUG07.S_BG_MEMBER,
                 CUG07.Q_CUST_BG_PRIORITY,
                 CUG07.Q_PREF_TIER_LEVEL,
MFMIGR           CONVERT(CHAR(10),CUG07.D_BG_TIER_START,101)
                 FROM
                   CUG07,
                   SAG03
                 WHERE CUG07.I_CUSTOMER = :OMGPR-I-CUSTOMER AND
                  CUG07.D_CUST_BG_PRI_EFF = :CUG07-D-CUST-BG-PRI-EFF AND
                  SAG03.D_BG_TIER_START <= :WS-CURRENT-DB2-DATE AND
                  (SAG03.D_BG_TIER_EXPIRE >= :WS-CURRENT-DB2-DATE OR
                  SAG03.D_BG_TIER_EXPIRE IS NULL) AND
                  CUG07.I_BUY_GROUP = SAG03.I_BUY_GROUP AND
                  CUG07.Q_PREF_TIER_LEVEL = SAG03.Q_PREF_TIER_LEVEL AND
                  CUG07.D_BG_TIER_START = SAG03.D_BG_TIER_START
               ORDER BY Q_CUST_BG_PRIORITY
               FOR FETCH ONLY
               OPTIMIZE FOR 1 ROW
           END-EXEC.

           EXEC SQL
             DECLARE A6Z01_C_CUG11 CURSOR FOR
               SELECT
                 CUG11.I_BUY_GROUP,
                 CUG11.S_BG_MEMBER,
                 CUG11.Q_ACCT_BG_PRIORITY,
                 CUG11.Q_PREF_TIER_LEVEL,
MFMIGR           CONVERT(CHAR(10),CUG11.D_BG_TIER_START,101)
                 FROM
                   CUG11,
                   SAG03
                 WHERE CUG11.I_ACCOUNT = :OMGPR-I-ACCOUNT AND
                  CUG11.D_ACCT_BG_PRI_EFF = :CUG11-D-ACCT-BG-PRI-EFF AND
                  SAG03.D_BG_TIER_START <= :WS-CURRENT-DB2-DATE AND
                  (SAG03.D_BG_TIER_EXPIRE >= :WS-CURRENT-DB2-DATE OR
                  SAG03.D_BG_TIER_EXPIRE IS NULL) AND
                  CUG11.I_BUY_GROUP = SAG03.I_BUY_GROUP AND
                  CUG11.Q_PREF_TIER_LEVEL = SAG03.Q_PREF_TIER_LEVEL AND
                  CUG11.D_BG_TIER_START = SAG03.D_BG_TIER_START
               ORDER BY Q_ACCT_BG_PRIORITY
               FOR FETCH ONLY
               OPTIMIZE FOR 1 ROW
           END-EXEC.

           EXEC SQL
             DECLARE A6Z01_S_CUG07 CURSOR FOR
               SELECT
                 CUG07.I_BUY_GROUP,
                 CUG07.S_BG_MEMBER,
                 CUG07.Q_CUST_BG_PRIORITY,
                 BGG01.I_DIVISION
                 FROM
                   CUG07,
                   BGG01
                 WHERE CUG07.I_CUSTOMER = :OMGPR-I-CUSTOMER AND
                  CUG07.D_CUST_BG_PRI_EFF = :CUG07-D-CUST-BG-PRI-EFF AND
                  CUG07.I_BUY_GROUP = BGG01.I_BUY_GROUP AND
                  BGG01.D_BG_EFFECT <= :WS-CURRENT-DB2-DATE AND
                  (BGG01.D_BG_EXPIRE >= :WS-CURRENT-DB2-DATE OR
                  BGG01.D_BG_EXPIRE IS NULL)
